{
  "name": "@fi-workers/lint",
  "version": "0.1.0",
  "description": "fi-workers shared strict lint, format and TypeScript settings (Oxlint, Oxfmt, knip, ast-grep)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fi-workers/lint.git"
  },
  "files": [
    "oxlint/",
    "presets/",
    "tsconfig/",
    "ast-grep/rules/"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./oxlint/base.d.ts",
      "default": "./oxlint/base.js"
    },
    "./oxlint/*": {
      "types": "./oxlint/*.d.ts",
      "default": "./oxlint/*.js"
    },
    "./oxfmt": {
      "types": "./presets/oxfmt.d.ts",
      "default": "./presets/oxfmt.js"
    },
    "./knip": {
      "types": "./presets/knip.d.ts",
      "default": "./presets/knip.js"
    },
    "./tsconfig/*": "./tsconfig/*",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --disable-nested-config",
    "knip": "knip",
    "sg": "ast-grep scan",
    "sg:test": "ast-grep test --skip-snapshot-tests",
    "test": "node --test test/*.test.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm knip && pnpm sg && pnpm sg:test && pnpm test"
  },
  "devDependencies": {
    "@ast-grep/cli": "0.51.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "react": "19.3.1",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@ast-grep/cli": "0.51.2",
    "knip": "6.45.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@ast-grep/cli": {
      "optional": true
    },
    "knip": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
